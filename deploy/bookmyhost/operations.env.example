# STK-099: private /etc/stock-discovery/operations.env, owner-only, reviewed paths.
# Never enable timers from this incomplete example. No new paid destination.
STK_STATE_DIR=/var/lib/stock-discovery-ops
STK_MONITOR_MODE=receiver
# Copy the actual live project files/env selection from docker Compose labels.
STK_COMPOSE_COMMAND=
CODE_VERSION=
RESTIC_BINARY=/opt/stock-discovery-tools/restic-0.19.1/restic
RESTIC_REPOSITORY=
RESTIC_PASSWORD_FILE=/etc/stock-discovery/backup-password
# Supply backend-specific credentials privately; do not reuse provider tokens.
STK099_TRANSFER_CONFIG=/etc/stock-discovery/backup.json
STK_RECOVERY_BUNDLE=/var/lib/stock-discovery-ops/recovery.bundle
# Existing executable reads allowlisted JSON on stdin; must exit nonzero on failure.
STK_ALERT_EXECUTABLE=
# Existing receiver HTTPS origin (without webhook capability path).
APP_ORIGIN=
