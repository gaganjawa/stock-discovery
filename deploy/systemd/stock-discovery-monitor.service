[Unit]
Description=Stock Discovery health and recovery checks
After=docker.service
[Service]
Type=oneshot
User=root
WorkingDirectory=/opt/stock-discovery
EnvironmentFile=/etc/stock-discovery/operations.env
ExecStart=/usr/bin/python3 scripts/operate.py monitor
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
TimeoutStartSec=2min
