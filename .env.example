# Local-only defaults for the synthetic local stack. Do not add credentials here.
POSTGRES_DB=stock_discovery
POSTGRES_USER=stock_discovery
POSTGRES_PASSWORD=change-me-for-local-use
POSTGRES_PORT=5432
API_PORT=8000
WEB_PORT=5173

# Ports bind only to localhost. Use URL-safe local password values.
# Never put broker, market-data or LLM credentials in this template.

# Required owner key: generate at least 32 random characters, never commit it.
AUTH_TOKEN=
# Keep true behind HTTPS. false is permitted only for loopback local preview.
COOKIE_SECURE=true
APP_ORIGIN=http://127.0.0.1:5173
CODE_VERSION=local-unversioned

# Optional explanation only. Add your key locally, then enable explicitly.
# Never commit a real API key. No LLM is needed for signals, sizing or replay.
LLM_ENABLED=false
OPENAI_API_KEY=
LLM_MODEL=gpt-4.1-mini
LLM_MAX_OUTPUT_TOKENS=512

# STK-094: optional receiver is disabled; no Premium subscription is required for tests.
CHARTINK_RECEIVER_ENABLED=false
# CHARTINK_SCANNER_CONFIG=/absolute/private/scanner.json
# CHARTINK_WEBHOOK_SECRET_FILE=/absolute/private/webhook.key
# CHARTINK_PULL_SECRET_FILE=/absolute/private/pull.key
# CHARTINK_RECEIVER_URL=https://owner-authorized-receiver.example
# Local stored-only candidate worker: python -m worker.main --candidate-intake
