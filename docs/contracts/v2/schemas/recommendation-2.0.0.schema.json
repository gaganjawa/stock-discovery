    "Admission": {
      "additionalProperties": false,
      "properties": {
        "quantity": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Quantity"
        },
        "reason": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Reason",
          "type": "string"
        },
        "reservation_ref": {
          "anyOf": [
            {
              "minLength": 1,
              "pattern": "\\S",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Reservation Ref"
        },
        "status": {
          "enum": [
            "not_requested",
            "admitted",
            "blocked",
            "expired"
          ],
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "status",
        "reservation_ref",
        "reason",
        "quantity"
      ],
      "title": "Admission",
      "type": "object"
    },
    "Cohort": {
      "additionalProperties": false,
      "properties": {
        "arm": {
          "enum": [
            "quant",
            "quant_rag",
            "quant_agent",
            "traditional_ml"
          ],
          "title": "Arm",
          "type": "string"
        },
        "capability": {
          "enum": [
            "technical_only",
            "researched",
            "predictive"
          ],
          "title": "Capability",
          "type": "string"
        },
        "config_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Config Hash",
          "type": "string"
        },
        "shadow": {
          "title": "Shadow",
          "type": "boolean"
        }
      },
      "required": [
        "arm",
        "config_hash",
        "capability",
        "shadow"
      ],
      "title": "Cohort",
      "type": "object"
    },
    "Condition": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Code",
          "type": "string"
        },
        "evidence_ids": {
          "items": {
            "minLength": 1,
            "pattern": "\\S",
            "type": "string"
          },
          "title": "Evidence Ids",
          "type": "array"
        },
        "explanation": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Explanation",
          "type": "string"
        }
      },
      "required": [
        "code",
        "explanation",
        "evidence_ids"
      ],
      "title": "Condition",
      "type": "object"
