        "invalidation": {
          "items": {
            "$ref": "#/$defs/Condition"
          },
          "title": "Invalidation",
          "type": "array"
        },
        "review": {
          "items": {
            "$ref": "#/$defs/Condition"
          },
          "minItems": 1,
          "title": "Review",
          "type": "array"
        }
      },
      "required": [
        "entry",
        "invalidation",
        "review",
        "expires_at"
      ],
      "title": "Conditions",
      "type": "object"
    },
