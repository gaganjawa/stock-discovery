      "required": [
        "evidence_id",
        "revision_id",
        "instrument_id",
        "kind",
        "source_ref",
        "source_version",
        "locator",
        "published_at",
        "available_at",
        "fetched_at",
        "period_end_at",
        "availability_basis",
        "archive_verification_ref",
        "summary"
